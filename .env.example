# Скопируйте в .env и заполните.

# Порт приложения на сервере
APP_PORT=3000

# Пароль базы PostgreSQL (для docker-compose)
POSTGRES_PASSWORD=смените-этот-пароль

# Секретный ключ для сессий: длинная случайная строка (например, openssl rand -hex 32)
JWT_SECRET=

# Первый администратор (создаётся, если пользователей ещё нет)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# 1 = при пустой базе загрузить демонстрационные данные (для пробного запуска; на боевом сервере 0)
SEED_DEMO=0

# Длительность сессии, часов
SESSION_HOURS=12

# 1 = cookie только по HTTPS (включите, если приложение открывается через https)
COOKIE_SECURE=0

# Если приложение стоит за обратным прокси (nginx), укажите 1
# TRUST_PROXY=1

# Без DATABASE_URL используется SQLite-файл data/training.db
# DATABASE_URL=postgres://user:password@host:5432/training
